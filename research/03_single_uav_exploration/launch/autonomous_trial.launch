<launch>
  <arg name="exploration_launch"/>
  <arg name="duration_s" default="1800.0"/>
  <arg name="result_file" default="/tmp/ruins_fuel_base_runtime.json"/>
  <arg name="map_file" default="/tmp/ruins_fuel_base_final.pcd"/>
  <arg name="trigger_delay_s" default="5.0"/>
  <arg name="trigger_timeout_s" default="60.0"/>

  <include file="$(arg exploration_launch)"/>

  <node pkg="ruins_single_uav_exploration"
        type="exploration_runtime_monitor.py"
        name="fuel_exploration_runtime_monitor"
        output="screen"
        required="true">
    <param name="duration_s" value="$(arg duration_s)"/>
    <param name="result_file" value="$(arg result_file)"/>
    <param name="map_file" value="$(arg map_file)"/>
    <param name="odom_topic" value="/state_ukf/odom"/>
    <param name="trigger_topic" value="/waypoint_generator/waypoints"/>
    <param name="bspline_topic" value="/planning/bspline"/>
    <param name="position_command_topic" value="/planning/pos_cmd"/>
    <param name="occupancy_topic" value="/sdf_map/occupancy_all"/>
    <param name="finish_log_text" value="finish exploration."/>
  </node>

  <include file="$(find ruins_single_uav_exploration)/launch/automatic_trigger.launch">
    <arg name="delay_s" value="$(arg trigger_delay_s)"/>
    <arg name="timeout_s" value="$(arg trigger_timeout_s)"/>
  </include>
</launch>
