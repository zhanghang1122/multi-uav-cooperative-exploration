<launch>
  <arg name="duration_s" default="90.0"/>
  <arg name="result_file" default="/tmp/ruins_mapping_runtime.json"/>

  <node pkg="ruins_mapping_baseline" type="runtime_monitor.py"
        name="mapping_runtime_monitor" output="screen">
    <param name="duration_s" value="$(arg duration_s)"/>
    <param name="result_file" value="$(arg result_file)"/>
    <param name="odom_topic" value="/quad_0/lidar_slam/odom"/>
    <param name="local_cloud_topic" value="/quad0_pcl_render_node/sensor_cloud"/>
    <param name="mapping_cloud_topic" value="/mapping/input_cloud"/>
    <param name="truth_cloud_topic" value="/map_generator/global_cloud"/>
    <param name="octomap_topic" value="/octomap_binary"/>
    <param name="occupied_centers_topic" value="/octomap_point_cloud_centers"/>
  </node>
</launch>
