<launch>
  <!-- Keep the complete project display in one checked RViz configuration:
       online floor, vertical obstacles, the UAV marker, and trajectory. -->
  <arg name="rviz_config"
       default="$(find ruins_urban_01)/rviz/e2_b1_online_mapping.rviz" />

  <!-- These two nodes are display-only.  FUEL, its raw occupancy stream, the
       recorder, and offline evaluation are not changed. -->
  <node pkg="ruins_urban_01" type="filter_online_map_for_viz.py"
        name="ruins_online_map_visual_filter" output="screen"
        args="--input-topic /sdf_map/occupancy_all --floor-output-topic /ruins_urban_01/online_floor_visual --obstacle-output-topic /ruins_urban_01/online_obstacle_visual --floor-max-z-m 0.25 --max-visible-z-m 2.30 --display-frame world --visual-voxel-size-m 0.15 --min-publish-period-s 0.8" />
  <node pkg="ruins_urban_01" type="publish_uav_pose_marker.py"
        name="ruins_uav_pose_marker" output="screen"
        args="--odom-topic /state_ukf/odom --output-topic /ruins_urban_01/uav_pose_marker --display-frame world" />
  <node pkg="rviz" type="rviz" name="fuel_b1_rviz"
        args="-d $(arg rviz_config)"
        output="screen" />
</launch>
