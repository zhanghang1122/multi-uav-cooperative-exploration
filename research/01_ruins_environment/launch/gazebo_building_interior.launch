<launch>
  <!--
    Geometry-only benchmark world. It contains no planner route, goal, frontier,
    or truth-map interface: exploration software receives only its runtime sensors.
  -->
  <arg name="world_file" default="Building-Interior-S2-Damaged-Building.world"/>
  <arg name="gui" default="true"/>
  <arg name="paused" default="false"/>
  <arg name="verbose" default="false"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find ruins_urban_01)/gazebo/worlds/$(arg world_file)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="verbose" value="$(arg verbose)"/>
    <arg name="use_sim_time" value="true"/>
  </include>
</launch>
