<launch>
  <arg name="depth_topic" default="/pcl_render_node/depth"/>
  <arg name="sensor_pose_topic" default="/pcl_render_node/sensor_pose"/>
  <arg name="mapping_cloud_topic" default="/ruins_global_mapping/depth_cloud_sensor"/>
  <arg name="map_frame" default="map"/>
  <arg name="resolution" default="0.10"/>
  <arg name="max_range_m" default="5.0"/>

  <node pkg="ruins_single_uav_exploration" type="fuel_depth_to_cloud.py"
        name="fuel_depth_to_cloud" output="screen"
        args="--depth-topic $(arg depth_topic) --sensor-pose-topic $(arg sensor_pose_topic) --output-cloud-topic $(arg mapping_cloud_topic) --map-frame $(arg map_frame) --max-depth-m $(arg max_range_m)"/>

  <node pkg="octomap_server" type="octomap_server_node"
        name="ruins_global_octomap" output="screen">
    <remap from="cloud_in" to="$(arg mapping_cloud_topic)"/>
    <param name="frame_id" value="$(arg map_frame)"/>
    <param name="resolution" value="$(arg resolution)"/>
    <param name="sensor_model/max_range" value="$(arg max_range_m)"/>
    <param name="sensor_model/hit" value="0.70"/>
    <param name="sensor_model/miss" value="0.40"/>
    <param name="sensor_model/min" value="0.12"/>
    <param name="sensor_model/max" value="0.97"/>
    <param name="pointcloud_min_z" value="-0.3"/>
    <param name="pointcloud_max_z" value="8.0"/>
    <param name="occupancy_min_z" value="-0.3"/>
    <param name="occupancy_max_z" value="8.0"/>
    <param name="filter_ground" value="false"/>
    <param name="filter_speckles" value="true"/>
    <param name="latch" value="false"/>
  </node>
</launch>
