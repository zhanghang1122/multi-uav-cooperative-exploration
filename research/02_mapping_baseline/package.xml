  <maintainer email="zhanghang1122@users.noreply.github.com">zhanghang1122</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>octomap_msgs</exec_depend>
